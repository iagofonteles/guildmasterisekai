.front-door { padding: 12px; background-color: #292332; color: #fff4d9; }
.door-status { min-height: 32px; padding-left: 40px; -unity-text-align: middle-left; background-image: url("project://database/Assets/Scripts/GuildMasterIsekai/Interactables/guild-closed.png"); background-position-x: left; background-size: 32px 32px; background-repeat: no-repeat; }
.door-status.is-open { background-image: url("project://database/Assets/Scripts/GuildMasterIsekai/Interactables/guild-open.png"); }
