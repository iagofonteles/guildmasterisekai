.build-document {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
.build-screen {
    flex-grow: 1;
    -unity-font: url("project://database/Assets/Plugins/TextMesh Pro/Fonts/LiberationSans.ttf");
    color: rgb(240, 244, 250);
    font-size: 13px;
}
.build-toolbar {
    position: absolute;
    left: 12px;
    top: 12px;
    bottom: 12px;
    width: 240px;
    max-width: 45%;
}
.build-toolbar .row {
    flex-direction: row;
    flex-shrink: 0;
}
.build-toolbar Button,
.build-toolbar .tile-choice {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    height: 40px;
    margin: 0 3px;
    padding: 4px;
    background-color: rgb(30, 38, 53);
    color: rgb(240, 244, 250);
    border-width: 2px;
    border-color: rgb(83, 100, 149);
    border-radius: 3px;
    -unity-text-align: middle-center;
}
.build-toolbar Button:hover,
.build-toolbar .tile-choice:hover { background-color: rgb(49, 65, 92); }
.build-toolbar Button.selected,
.build-toolbar .tile-choice.selected {
    background-color: rgb(49, 75, 133);
    border-color: rgb(135, 175, 255);
}
.build-toolbar Button:disabled,
.build-toolbar .tile-choice:disabled { opacity: 0.4; }
.build-toolbar .tile-list {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 60px;
    margin: 8px 3px;
    padding: 5px;
    background-color: rgba(25, 30, 42, 0.97);
    border-width: 2px;
    border-color: rgb(83, 100, 149);
    border-radius: 3px;
    overflow: hidden;
}
.tile-list .unity-scroll-view__content-viewport {
    overflow: hidden;
    min-width: 0;
}
.tile-list .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}
.build-toolbar .tile-choice {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: 64px;
    height: 64px;
    min-height: 64px;
    margin: 3px;
    padding: 4px;
}
.build-toolbar .slot-icon,
.build-toolbar .slot-placeholder {
    position: absolute;
    left: 4px;
    right: 4px;
    top: 4px;
    bottom: 4px;
}
.build-toolbar .slot-placeholder {
    font-size: 32px;
    -unity-text-align: middle-center;
}
.build-toolbar .tile-icon { width: 32px; height: 32px; margin-right: 8px; flex-shrink: 0; }
.build-toolbar .auxiliary-controls Label { white-space: normal; }
.build-toolbar .unity-scroller--vertical { width: 12px; }
.build-toolbar .unity-base-slider__tracker { background-color: rgb(17, 22, 30); }
.build-toolbar .unity-base-slider__dragger { background-color: rgb(110, 135, 166); min-width: 8px; min-height: 8px; }

.build-toolbar .tool-tabs {
    flex-wrap: wrap;
    flex-shrink: 0;
    min-height: 40px;
}
.build-toolbar .brush-choice {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: 40px;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
}
.build-toolbar .brush-icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
}
.build-toolbar .tile-choice .tile-amount {
    position: absolute;
    right: 3px;
    bottom: 2px;
    -unity-text-align: lower-right;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(30, 38, 53);
}
.build-toolbar .hidden { display: none; }

.slot-preset {
    flex-grow: 1;
}
.preset-regions {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
}
.preset-region {
    width: 50%;
    height: 50%;
    flex-shrink: 0;
}
.preset-ramp-label {
    flex-grow: 1;
    font-size: 16px;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.grid-selection-outline {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.tool-cursor-icon {
    position: absolute;
    left: 0;
    top: 0;
    width: 32px;
    height: 32px;
}
.tool-cursor-icon.hidden { display: none; }
