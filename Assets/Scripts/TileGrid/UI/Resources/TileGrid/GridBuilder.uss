.build-document {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
.build-screen {
    flex-grow: 1;
    -unity-font: url("project://database/Assets/Plugins/TextMesh Pro/Fonts/LiberationSans.ttf");
    color: rgb(240, 244, 250);
    font-size: 13px;
}
.build-toolbar {
    position: absolute;
    left: 12px;
    top: 12px;
    bottom: 12px;
    width: 240px;
    max-width: 45%;
}
.build-toolbar .row {
    flex-direction: row;
    flex-shrink: 0;
}
.build-toolbar Button {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    height: 40px;
    margin: 0 3px;
    padding: 4px;
    background-color: rgb(30, 38, 53);
    color: rgb(240, 244, 250);
    border-width: 2px;
    border-color: rgb(83, 100, 149);
    border-radius: 3px;
    -unity-text-align: middle-center;
}
.build-toolbar Button:hover { background-color: rgb(49, 65, 92); }
.build-toolbar Button.selected {
    background-color: rgb(49, 75, 133);
    border-color: rgb(135, 175, 255);
}
.build-toolbar Button:disabled { opacity: 0.4; }
.build-toolbar .tile-list {
    flex-grow: 1;
    min-height: 60px;
    margin: 8px 3px;
    padding: 5px;
    background-color: rgba(25, 30, 42, 0.97);
    border-width: 2px;
    border-color: rgb(83, 100, 149);
    border-radius: 3px;
}
.build-toolbar .tile-choice {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    flex-shrink: 0;
    flex-basis: auto;
    height: auto;
    min-height: 44px;
    margin: 3px 0;
    padding: 6px;
}
.build-toolbar .tile-choice Label {
    flex-grow: 1;
    white-space: normal;
    -unity-text-align: middle-left;
}
.build-toolbar .tile-icon { width: 32px; height: 32px; margin-right: 8px; flex-shrink: 0; }
.build-toolbar .auxiliary-controls Label { white-space: normal; }
.build-toolbar .unity-scroller--vertical { width: 12px; }
.build-toolbar .unity-base-slider__tracker { background-color: rgb(17, 22, 30); }
.build-toolbar .unity-base-slider__dragger { background-color: rgb(110, 135, 166); min-width: 8px; min-height: 8px; }

.build-toolbar .tool-tabs {
    flex-wrap: wrap;
    flex-shrink: 0;
    min-height: 40px;
}
.build-toolbar .brush-choice {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: 40px;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
}
.build-toolbar .brush-icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
}